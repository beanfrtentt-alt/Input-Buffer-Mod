{
    "geode":       "5.11.2",
    "gd":          { "win": "2.2081", "android": "2.2081", "mac": "2.2081", "ios": "2.2081" },
    "version":     "2.0.0",
    "id":          "dev.spoonclient.mod",
    "name":        "Spoon Client",
    "developer":   "Spoon Client Team",
    "description": "Geometry Dash 2.2081 gameplay toolkit: F6 settings menu, per-gamemode input buffering, and a working Assisted Gameplay automation system.",
    "homepage":    "https://github.com/beanfrtentt-alt/Input-Buffer-Mod",
    "repository":  "https://github.com/beanfrtentt-alt/Input-Buffer-Mod",
    "issues":      { "url": "https://github.com/beanfrtentt-alt/Input-Buffer-Mod/issues" },
    "tags":        [ "gameplay", "input", "automation", "menu", "tools" ],
    "dependencies": {
        "geode.node-ids": ">=v1.23.3"
    },
    "settings": {
        "configVersion": {
            "default": 2,
            "type": "int",
            "hidden": true
        },
        "menuKey": {
            "default": "F6",
            "type": "keybind",
            "name": "Open / Close Menu",
            "description": "Key that opens the Spoon Client menu.",
            "category": "universal"
        },
        "agEmergencyStopKey": {
            "default": "F8",
            "type": "keybind",
            "name": "Assisted Gameplay Emergency Stop",
            "description": "Immediately disables Assisted Gameplay while in gameplay.",
            "category": "gameplay"
        },
        "agEnabled": {
            "default": false,
            "type": "bool",
            "name": "Assisted Gameplay Enabled",
            "description": "When enabled, Spoon Client attempts to play the current level automatically. Toggle this in-game with the F6 menu."
        },
        "agStrategy": {
            "default": "receding-horizon",
            "type": "string",
            "name": "Assisted Gameplay Strategy",
            "description": "receding-horizon = look-ahead obstacle avoidance; static-analysis = use precomputed object layout.",
            "one-of": ["receding-horizon", "static-analysis"]
        },
        "agLookaheadFrames": {
            "default": 18,
            "type": "int",
            "name": "Assisted Gameplay Lookahead (frames)",
            "description": "Number of gameplay frames (~1/240 s each in GD physics) to look ahead when planning inputs.",
            "min": 4,
            "max": 90
        },
        "agShowOverlay": {
            "default": true,
            "type": "bool",
            "name": "Show Assisted Gameplay Overlay",
            "description": "Displays a small status indicator during gameplay."
        },
        "agShowDebug": {
            "default": false,
            "type": "bool",
            "name": "Show Assisted Gameplay Debug Logs",
            "description": "Spammy — only enable when troubleshooting."
        },

        "bufferCubeEnabled":     { "default": true,  "type": "bool",   "name": "Cube Buffer Enabled" },
        "bufferCubeFrames":      { "default": 8,      "type": "int",    "name": "Cube Buffer (frames)",     "min": 0, "max": 30 },
        "bufferShipEnabled":     { "default": true,  "type": "bool",   "name": "Ship Buffer Enabled" },
        "bufferShipFrames":      { "default": 6,     "type": "int",    "name": "Ship Buffer (frames)",     "min": 0, "max": 30 },
        "bufferBallEnabled":     { "default": true,  "type": "bool",   "name": "Ball Buffer Enabled" },
        "bufferBallFrames":      { "default": 6,      "type": "int",    "name": "Ball Buffer (frames)",     "min": 0, "max": 30 },
        "bufferUfoEnabled":      { "default": true,  "type": "bool",   "name": "UFO Buffer Enabled" },
        "bufferUfoFrames":       { "default": 6,      "type": "int",    "name": "UFO Buffer (frames)",      "min": 0, "max": 30 },
        "bufferWaveEnabled":     { "default": true,  "type": "bool",   "name": "Wave Buffer Enabled" },
        "bufferWaveFrames":      { "default": 4,      "type": "int",    "name": "Wave Buffer (frames)",     "min": 0, "max": 30 },
        "bufferRobotEnabled":    { "default": true,  "type": "bool",   "name": "Robot Buffer Enabled" },
        "bufferRobotFrames":     { "default": 8,      "type": "int",    "name": "Robot Buffer (frames)",    "min": 0, "max": 30 },
        "bufferSpiderEnabled":   { "default": true,  "type": "bool",   "name": "Spider Buffer Enabled" },
        "bufferSpiderFrames":    { "default": 6,      "type": "int",    "name": "Spider Buffer (frames)",    "min": 0, "max": 30 },
        "bufferSwingEnabled":    { "default": true,  "type": "bool",   "name": "Swing Buffer Enabled" },
        "bufferSwingFrames":     { "default": 6,      "type": "int",    "name": "Swing Buffer (frames)",     "min": 0, "max": 30 }
    }
}
